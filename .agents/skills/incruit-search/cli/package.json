{
  "name": "incruit-cli",
  "version": "1.0.0",
  "description": "Search Incruit Korean job postings from public HTML. Personal use only.",
  "type": "module",
  "main": "src/cli.ts",
  "bin": {
    "incruit-search": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "test:live": "INCRUIT_LIVE=1 bun test --timeout 90000 tests/live-smoke.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/bun": "1.3.14"
  }
}
