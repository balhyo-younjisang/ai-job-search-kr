# Codex command rules for this workspace: the Codex counterpart of the
# permissions in .claude/settings.json. Loaded only when you mark the project
# as trusted in Codex. Decisions: "allow" runs the command outside the sandbox
# (network on) without a prompt, "prompt" asks every time, "forbidden" blocks.
# A pattern is an exact argument prefix; extra trailing arguments still match.
#
# allow is deliberately narrower than settings.json: only the repo's own
# commands that need the network, plus posting_guard. The workflows pipe a
# portal CLI straight into it (`... detail <id> --format plain | python3
# tools/posting_guard.py --text --json`), and Codex allows a pipeline only when
# every segment is allowed; without this rule the whole pipeline falls back to
# the sandbox, loses the network and asks for escalation. The other local tools
# (rank_state, job_key, verify_pdf, ...) run inside Codex's default
# workspace-write sandbox without a prompt, so they are not lifted out of it.
# A command with redirection (`>`), substitution or variables is matched as one
# script and never by these rules: AGENTS.md tells agents to run these plain.
# tests/test_codex_runtime.py keeps this file in step with settings.json.

prefix_rule(
    pattern = ["bun", "run", ".agents/skills/linkedin-search/cli/src/cli.ts"],
    decision = "allow",
    justification = "linkedin-search portal CLI (network)",
    match = ["bun run .agents/skills/linkedin-search/cli/src/cli.ts search -q backend --format json"],
    not_match = ["bun run .agents/skills/linkedin-search/cli/src/other.ts"],
)

