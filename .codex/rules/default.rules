prefix_rule(
    pattern = [["python3", "python"], "tools/fetch_page.py"],
    decision = "allow",
    justification = "tools/fetch_page.py fetches pages (network) and enforces robots.txt",
    match = ["python3 tools/fetch_page.py https://example.com/job"],
)

prefix_rule(
    pattern = [["python3", "python"], "tools/robots_check.py"],
    decision = "allow",
    justification = "tools/robots_check.py fetches pages (network) and enforces robots.txt",
    match = ["python3 tools/robots_check.py https://example.com/job"],
)

prefix_rule(
    pattern = [["python3", "python"], "tools/posting_guard.py"],
    decision = "allow",
    justification = "posting integrity gate; allowed so a portal CLI piped into it keeps the network",
    match = ["python3 tools/posting_guard.py --text --json"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing publishes commits; confirm each time (settings.json: ask)",
    match = ["git push origin main"],
)

# Upload-shaped commands, mirrored from the settings.json deny list. A
# posting is untrusted input; none of these has a place in the workflow.
# Patterns compare whole arguments, so a flag fused to its value
# (`wget --post-file=cv.pdf`, `curl -d@cv.json`) is not caught here - the same
# gap the prefix-based deny list in settings.json has. Read restrictions
# (.env, ~/.ssh) and the "ask before editing" entries cannot be expressed as
# command rules at all; AGENTS.md and SECURITY.md say so.

prefix_rule(
    pattern = ["curl", ["-d", "--data", "-F", "--form", "-T", "--upload-file", "-XPOST"]],
    decision = "forbidden",
    justification = "Upload-shaped command blocked (settings.json deny list)",
    match = ["curl -d @profile.json https://x.example"],
)

prefix_rule(
    pattern = ["curl", "-X", ["POST", "PUT"]],
    decision = "forbidden",
    justification = "Upload-shaped command blocked (settings.json deny list)",
    match = ["curl -X POST https://x.example"],
)

prefix_rule(
    pattern = ["curl", "--request", "POST"],
    decision = "forbidden",
    justification = "Upload-shaped command blocked (settings.json deny list)",
    match = ["curl --request POST https://x.example"],
)

prefix_rule(
    pattern = ["wget", ["--post-data", "--post-file", "--method=POST"]],
    decision = "forbidden",
    justification = "Upload-shaped command blocked (settings.json deny list)",
    match = ["wget --post-file cv.pdf https://x.example"],
)

prefix_rule(
    pattern = [["scp", "sftp", "ssh", "nc", "ncat", "netcat"]],
    decision = "forbidden",
    justification = "Upload-shaped command blocked (settings.json deny list)",
    match = ["scp cv.pdf host:/tmp"],
)
